NEXT_PUBLIC_SITE_NAME="Services Plus"
NEXT_PUBLIC_WHATSAPP_PHONE=918800028794
NEXT_PUBLIC_SUPPORT_PHONE="+91-9899184918"
NEXT_PUBLIC_SALES_PHONE="+91-8800028794"
NEXT_PUBLIC_GTM_ID="GTM-KS8X8MJ5"

# Backend Adapter Integration
BACKEND_API_URL=https://www.servicesplus.in

# CMS backend (Tax Alphonic CMS API, see docs/CMS_INTEGRATION.md). Server-only: never used in client code.
BASE_URL=http://192.168.0.166:5000
# Where CMS media is served from (defaults to BASE_URL).
IMAGE_BASE_URL=http://192.168.0.166:5000
# Public origin: canonical URLs, sitemap.xml, robots.txt.
SITE_URL=https://www.servicesplus.in
# This website's menus in Menus & Navigation (by name; else the active menu of that location).
SITE_HEADER_MENU="Services Plus Header"
SITE_FOOTER_MENU="Services Plus Footer"
# Admin origins allowed to frame /cms-preview (Live Preview), comma-separated.
CMS_ADMIN_ORIGIN=http://localhost:5173
# Landing pages: services.<domain>/lp/<label> (LANDING_SITE_URL overrides the landing origin).
LANDING_BASE_DOMAINS=servicesplus.in,localhost
# Extra hosts allowed to post Server Actions (forms), comma-separated.
SERVER_ACTION_ORIGINS=
